ARG MA_BASE=ghcr.io/music-assistant/server@sha256:4ac0d5844363fbbefd6a61251df09d96cd546e05e01b8c1cc1a28803f0935e07
FROM ${MA_BASE} AS certificates
USER 0:0
COPY opendeezer-home /tmp/opendeezer-home
RUN chmod 0555 /tmp/opendeezer-home
FROM scratch
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=certificates /tmp/opendeezer-home /opendeezer-home
USER 65532:65532
ENTRYPOINT ["/opendeezer-home"]
