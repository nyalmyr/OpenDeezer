  },
  "opendeezer_deplacer": {
    "alias": "Musique familiale — déplacer la musique",
    "description": "Transférer la file musicale d'une pièce vers une autre, en utilisant Music Assistant. Pas de confirmation vocale après réussite. Une destination sans enceinte est une erreur.",
    "mode": "queued",
    "max": 4,
    "fields": {
      "source": {
        "description": "Pièce où la musique joue actuellement.",
        "required": true,
        "selector": {
          "text": {}
        }
      },
      "destination": {
        "description": "Pièce ou groupe de destination explicitement demandé.",
        "required": true,
        "selector": {
          "text": {}
        }
      }
    },
    "sequence": [
      {
        "action": "rest_command.opendeezer_family",
        "data": {
          "operation": "transfer",
          "parameters": "{{ {'source': source, 'destination': destination} }}"
        },
        "response_variable": "family_reply"
      },
      {
        "if": [
          {
            "condition": "template",
            "value_template": "{{ family_reply.status | int != 200 }}"
          }
        ],
        "then": [
          {
            "variables": {
              "failure": {
                "success": false,
                "error": "{{ family_reply.content.get('message', family_reply.content.get('error', 'Service musical indisponible')) if family_reply.content is mapping else family_reply.content | string | truncate(300) }}"
              }
            }
          },
          {
            "stop": "Échec de la demande musicale",
            "response_variable": "failure"
          }
        ]
      },
      {
        "variables": {
          "result": "{{ family_reply.content }}"
        }
      },
      {
        "stop": "Action musicale terminée",
        "response_variable": "result"
      }
    ]
  }
}